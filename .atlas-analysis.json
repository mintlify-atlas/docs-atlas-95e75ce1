  "keyFeatures": [
    "Chromium-based browser engine with privacy-first modifications for all major platforms",
    "Brave Shields: ad blocking, tracker blocking, and fingerprinting protection powered by adblock-rust",
    "Brave Rewards: privacy-preserving user reward system using anonymous credentials (VOPRF/Privacy Pass)",
    "Brave Wallet: multi-chain cryptocurrency wallet supporting ETH, BTC, SOL, ZEC, FIL, and more",
    "Brave VPN: built-in VPN with Privacy Pass credential system decoupling payment from usage",
    "Brave Ads: privacy-preserving advertising system with on-device targeting",
    "AI Chat (Leo): privacy-preserving LLM integration using OHTTP for secure inference",
    "Tor integration: built-in Tor private window support",
    "IPFS support: native decentralized web navigation",
    "Griffin (Variations): Brave's Finch-compatible feature rollout and experimentation service",
    "P3A: privacy-preserving product analytics using STAR/PPOPRF cryptography",
    "Plaster: semantic patching system for maintainable Chromium modifications",
    "Speedreader: browser-native article reading mode",
    "Brave Sync: end-to-end encrypted cross-device sync",
    "Brave News: personalized news feed with privacy-preserving discovery"
  ],
  "publicApiSurface": [
    "pnpm run init [--target_os=android|ios] [--target_arch=arm]",
    "pnpm run sync [--force] [--init] [--create] [brave_core_ref]",
    "pnpm run build [Release|Static|Debug]",
    "pnpm run test [brave_components_unittests|brave_unit_tests|brave_browser_tests|chromium_unit_tests]",
    "pnpm run test-unit [path filter]",
    "pnpm run update_patches",
    "pnpm run apply_patches",
    "pnpm run format",
    "pnpm run storybook",
    "pnpm start [Release|Component|Static|Debug]",
    "BraveContentBrowserClient (C++ embedder entry point)",
    "BraveBrowserProcess (browser process singleton)",
    "BraveShields component API",
    "BraveRewards service API",
